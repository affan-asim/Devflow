{
  "name": "dev-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "email:dev": "npx react-email dev --dir src/email",
    "email:worker": "tsx --tsconfig jsconfig.json src/workers/Email.worker.js",
    "storage:worker": "tsx --tsconfig jsconfig.json src/workers/storage.worker.js",
    "notification:worker": "tsx --tsconfig jsconfig.json src/workers/notification.worker.js",
    "job-expiration:worker": "tsx --tsconfig jsconfig.json src/workers/jobExpiration.worker.js",
    "workers": "concurrently -k -p \"[{name}]\" -n \"EMAIL,STORAGE,NOTIF,JOB-EXPIRATION\" -c \"cyan,blue,magenta,yellow\" \"npm:email:worker\" \"npm:storage:worker\" \"npm:notification:worker\" \"npm:job-expiration:worker\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "@react-email/components": "^1.0.12",
    "@reduxjs/toolkit": "^2.12.0",
    "@supabase/supabase-js": "^2.116.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.4",
    "framer-motion": "^13.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.46.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "resend": "^6.12.3",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@playwright/test": "^1.64.1",
    "@prisma/client": "^6.19.3",
    "@react-email/ui": "^6.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.5",
    "@types/react": "19.2.18",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.3",
    "prisma-erd-generator": "^3.2.1",
    "puppeteer": "^25.16.0",
    "react-email": "^6.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  }
}
