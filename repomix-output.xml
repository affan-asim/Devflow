model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  isVerified Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  role             ROLE              @default(DEVELOPER)
  developerProfile DeveloperProfile?
  recruiterProfile RecruiterProfile?
  notifications    Notification[]
  refreshToken     RefreshToken[]
  files            File[]

  @@index([role, isActive])
  @@index([isVerified, isActive])
  @@index([createdAt])
}

model RefreshToken {
  id          String    @id @default(uuid())
  hashedToken String    @unique
  revoked     Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  deviceName  String?
  ipAddress   String?
  userAgent   String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model File {
  id        String     @id @default(uuid())
  key       String     @unique
  userId    String
  type      FileType
  status    FileStatus @default(TEMP)
  createdAt DateTime   @default(now())

  // User Ownership
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  developerProfile DeveloperProfile?

  applicationResumes      Application[]     @relation("AppResume")
  applicationCoverLetters Application[]     @relation("AppCoverLetter")
  recruiterProfile        RecruiterProfile?

  @@index([userId])
  @@index([status, createdAt])
}

model DeveloperProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  bio                String?
  githubUrl          String?
  portfolioUrl       String?
  resumeId           String?   @unique
  locationPreference LOCATION?
  yearsOfExp         Decimal?

  user              User                @relation(fields: [userId], references: [id])
  employmentHistory EmploymentHistory[]
  skills            Skill[]
  savedJobs         SavedJob[]
  applications      Application[]
  resume            File?               @relation(fields: [resumeId], references: [id])

  @@index([locationPreference])
}

model RecruiterProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  companyId          String?
  bio                String?
  jobTitle           String?
  description        String?
  githubUrl          String?
  portfolioUrl       String?
  resumeId           String?  @unique
  locationPreference LOCATION
  yearsOfExp         Decimal?
  createdAt          DateTime @default(now())

  ownedCompany     Company?           @relation("CompanyOwner")
  user             User               @relation(fields: [userId], references: [id])
  company          Company?           @relation("CompanyRecruiters", fields: [companyId], references: [id])
  recruiterHistory RecruiterHistory[]
  jobs             Job[]
  resume           File?              @relation(fields: [resumeId], references: [id])

  hiredEmployments EmploymentHistory[] @relation("EmploymentHiredBy")

  approvedEmploymentEvents EmployementEvent[] @relation("EmploymentApprovedBy")

  approvedRecruiterEvents  RecruiterEvent[]     @relation("RecruiterApprovedBy")
  recruiterInvitesReceived RecruiterInvite[]    @relation("RecruiterInviteTarget")
  recruiterInvitesSender   RecruiterInvite[]    @relation("RecruiterInviteSender")
  companyJoinRequests      CompanyJoinRequest[]

  @@index([companyId])
  @@index([locationPreference])
}

model RecruiterInvite {
  id                   String         @id @default(uuid())
  companyId            String
  recruiterId          String?
  invitedByRecruiterId String
  invitedEmail         String
  roleTitle            String
  salary               Decimal?
  currency             Currency?
  employmentType       EmploymentType
  description          String?
  status               InviteStatus   @default(PENDING)
  expiresAt            DateTime
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  company   Company           @relation(fields: [companyId], references: [id])
