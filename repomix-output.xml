import { PrismaClient } from "@/generated/prisma/client";
import { AppError } from "@/utils/AppError";
import { getRecuiterProfile } from "../profile/recuiterService";
import { getDeveloperProfile } from "../profile/developerService";
import { developerProfileKey } from "@/utils/redisKeyNames";
import { redis } from "@/lib/redis";

const prisma = new PrismaClient()

export const getEmploymentHistoryList = async (searchParams, userId) => {
    const employmentType = searchParams.get("employmentType");
    const companyId = searchParams.get("companyId");
    const search = searchParams.get("search");
    const sort = searchParams.get("sort");

    const page = Number(searchParams.get("page") || 1);
    const pageSize = Number(searchParams.get("limit") || 10);

    const currentPage = Math.max(1, page);
    const limit = Math.max(1, pageSize);

    const profile = await getDeveloperProfile(userId)

    if (!profile) {
        throw new AppError("Create Your profile first!", 404)
    }

    const where = {
        devProfileId: profile.id
    };

    if (employmentType) {
        where.employmentType = employmentType
    }

    if (companyId) {
        where.companyId = companyId
    }

    if (search) {
        where.OR = [
            {
                OR: [
                    { roleTitle: { contains: search, mode: "insensitive" } },
                    { description: { contains: search, mode: "insensitive" } },
                    { currency: { equals: search } },
                ]
            }
        ]
    }

    let orderBy;

    if (sort) {
        if (sort === "salary") {
            orderBy = {
                salary: "desc"
            }
        }

        if (sort === "startDate") {
            orderBy = {
                startDate: "asc"
            }
        }

        if (sort === "endDate") {
            orderBy = {
                endDate: "desc"
            }
        }
    };

    const [employments, totalCount] = await prisma.$transaction([
        prisma.employmentHistory.findMany({
            where,
            take: limit,
            skip: (currentPage - 1) * limit,
            orderBy,
            include: {
                employmentEvents: {
                    select: {
                        status: true,
                        type: true,
                        id: true
                    }
                },
                company: {
                    select: {
                        id: true,
                        name: true,
                        description: true,
                        country: true,
                        industry: true,
                        logo: true,
                        isVerified: true,
                        websiteUrl: true,
                    }
                },
                hiredByRecruiter: {
                    select: {
                        id: true,
                        user: {
                            select: {
                                id: true,
                                name: true,
                            }
                        }
                    }
                }
            }
        }),
        prisma.employmentHistory.count({
            where
        })
    ])

    const totalPages = Math.ceil(totalCount / limit);

    const metadata = {
        currentPage,
        pageSize: limit,
        totalCount,
        totalPages,
        hasNextPage: currentPage < totalPages,
        hasPreviousPage: currentPage > 1,
    }

    return {
        employments,
        metadata
    }
};

