        title: true,
        status: true,
        employmentType: true,
        createdAt: true,
        company: { select: { id: true, name: true } },
      },
    }),
    prisma.application.findMany({
      take: 5,
      orderBy: { createdAt: "desc" },
      select: {
        id: true,
        status: true,
        createdAt: true,
        job: { select: { id: true, title: true } },
        developerProfile: {
          select: {
            id: true,
