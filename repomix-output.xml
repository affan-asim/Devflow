import { createAsyncThunk, createSlice } from "@reduxjs/toolkit";
import api from "@/lib/api/axios";

const getErrorMessage = (error, fallback) =>
  error.response?.data?.error || error.message || fallback;

/** Admin: Fetch companies with optional search, filters, and pagination. */
export const fetchAdminCompanies = createAsyncThunk(
  "adminCompanies/fetchAdminCompanies",
  async (params = {}, { rejectWithValue }) => {
    try {
      const response = await api.get("/api/company", { params });
      return response.data;
    } catch (error) {
      return rejectWithValue(getErrorMessage(error, "Failed to fetch companies"));
    }
  }
);

/** Admin: Fetch a company's details. */
export const fetchAdminCompanyById = createAsyncThunk(
  "adminCompanies/fetchAdminCompanyById",
  async (companyId, { rejectWithValue }) => {
    try {
      const response = await api.get(`/api/company/${companyId}`);
      return response.data;
    } catch (error) {
      return rejectWithValue(
        getErrorMessage(error, "Failed to fetch company details")
      );
    }
  }
);

/** Admin: Update a company's verification status. */
export const updateAdminCompanyVerification = createAsyncThunk(
  "adminCompanies/updateAdminCompanyVerification",
  async ({ companyId, isVerified }, { rejectWithValue }) => {
    try {
      const response = await api.patch(
        `/api/admin/company/${companyId}/verification`,
        { isVerified }
      );
      return response.data;
    } catch (error) {
      return rejectWithValue(
        getErrorMessage(error, "Failed to update company verification")
      );
    }
  }
);

const initialState = {
  companies: [],
  metadata: {
    currentPage: 1,
    pageSize: 10,
    totalCount: 0,
    totalPages: 0,
    hasNextPage: false,
    hasPreviousPage: false,
  },
  currentCompany: null,
  loadingList: false,
  loadingDetail: false,
  submitting: false,
  errorList: null,
  errorDetail: null,
  submitError: null,
};

const adminCompaniesSlice = createSlice({
  name: "adminCompanies",
  initialState,
  reducers: {
    clearCurrentAdminCompany: (state) => {
      state.currentCompany = null;
      state.errorDetail = null;
    },
    clearAdminCompaniesErrors: (state) => {
      state.errorList = null;
      state.errorDetail = null;
      state.submitError = null;
    },
    clearAdminCompanies: () => initialState,
  },
  extraReducers: (builder) => {
    builder
      .addCase(fetchAdminCompanies.pending, (state) => {
        state.loadingList = true;
        state.errorList = null;
      })
      .addCase(fetchAdminCompanies.fulfilled, (state, action) => {
        state.loadingList = false;
        const data = action.payload.data || {};
        state.companies = data.companies || data.comapanies || [];
        state.metadata = data.metadata || state.metadata;
      })
      .addCase(fetchAdminCompanies.rejected, (state, action) => {
        state.loadingList = false;
        state.errorList = action.payload;
      })

      .addCase(fetchAdminCompanyById.pending, (state) => {
        state.loadingDetail = true;
        state.errorDetail = null;
      })
      .addCase(fetchAdminCompanyById.fulfilled, (state, action) => {
        state.loadingDetail = false;
        state.currentCompany = action.payload.data;
      })
      .addCase(fetchAdminCompanyById.rejected, (state, action) => {
        state.loadingDetail = false;
        state.errorDetail = action.payload;
      })

      .addCase(updateAdminCompanyVerification.pending, (state) => {
        state.submitting = true;
        state.submitError = null;
      })
      .addCase(updateAdminCompanyVerification.fulfilled, (state, action) => {
        state.submitting = false;
        const updatedCompany = action.payload.data;
        if (!updatedCompany) return;

        state.companies = state.companies.map((company) =>
          company.id === updatedCompany.id
            ? { ...company, ...updatedCompany }
            : company
        );
        if (state.currentCompany?.id === updatedCompany.id) {
          state.currentCompany = { ...state.currentCompany, ...updatedCompany };
        }
      })
      .addCase(updateAdminCompanyVerification.rejected, (state, action) => {
        state.submitting = false;
        state.submitError = action.payload;
      });
  },
});

export const {
  clearCurrentAdminCompany,
  clearAdminCompaniesErrors,
  clearAdminCompanies,
} = adminCompaniesSlice.actions;

export default adminCompaniesSlice.reducer;
</file>

<file path="src/lib/redux/slices/adminEmailLogsSlice.js">
import { createAsyncThunk, createSlice } from "@reduxjs/toolkit";
import api from "@/lib/api/axios";

const getErrorMessage = (error, fallback) =>
  error.response?.data?.error ||
  error.response?.data?.message ||
  error.message ||
  fallback;

function normalizeListResponse(payload, previousPagination) {
  // Supports { logs, pagination }, { data: { logs, pagination } },
  // and legacy { data: [...], pagination } responses.
  const root =
    payload?.data && !Array.isArray(payload.data)
      ? payload.data
      : payload;

  const logs = Array.isArray(root?.logs)
    ? root.logs
    : Array.isArray(root?.data)
      ? root.data
      : Array.isArray(payload?.data)
        ? payload.data
        : [];

  const incoming = root?.pagination ?? payload?.pagination ?? {};
  const page = Number(incoming.page ?? previousPagination.page ?? 1);
  const limit = Number(incoming.limit ?? previousPagination.limit ?? 20);
  const total = Number(incoming.total ?? previousPagination.total ?? logs.length);
  const totalPages = Number(
    incoming.totalPages ??
      Math.ceil(total / Math.max(1, limit))
  );

  return {
    logs,
    pagination: {
      total: Number.isFinite(total) ? total : 0,
      page: Number.isFinite(page) && page > 0 ? page : 1,
      limit: Number.isFinite(limit) && limit > 0 ? limit : 20,
      totalPages:
        Number.isFinite(totalPages) && totalPages >= 0 ? totalPages : 0,
      hasNextPage:
        incoming.hasNextPage ?? page < totalPages,
      hasPreviousPage:
        incoming.hasPreviousPage ?? page > 1,
    },
  };
}

export const fetchAdminEmailLogs = createAsyncThunk(
  "adminEmailLogs/fetchList",
  async (params = {}, { rejectWithValue }) => {
    try {
      const response = await api.get("/api/admin/email-logs", { params });
      return response.data;
    } catch (error) {
      return rejectWithValue(
        getErrorMessage(error, "Failed to fetch email logs")
      );
    }
  }
);

export const deleteAdminEmailLog = createAsyncThunk(
  "adminEmailLogs/delete",
  async (emailLogId, { rejectWithValue }) => {
    try {
      const response = await api.delete(
        `/api/admin/email-logs/${encodeURIComponent(emailLogId)}`
      );

      return { emailLogId, response: response.data };
    } catch (error) {
      return rejectWithValue({
        emailLogId,
        message: getErrorMessage(error, "Failed to delete email log"),
      });
    }
  }
);

const initialState = {
  emailLogs: [],
  pagination: {
    total: 0,
    page: 1,
    limit: 20,
    totalPages: 0,
    hasNextPage: false,
    hasPreviousPage: false,
  },
  loadingList: false,
  deletingEmailLogIds: [],
  errorList: null,
  deleteErrors: {},
  requestId: null,
};

const adminEmailLogsSlice = createSlice({
  name: "adminEmailLogs",
  initialState,

  reducers: {
    clearAdminEmailLogsErrors(state) {
      state.errorList = null;
      state.deleteErrors = {};
    },

    clearAdminEmailLogDeleteError(state, action) {
      delete state.deleteErrors[action.payload];
    },

    resetAdminEmailLogs: () => ({
      ...initialState,
      emailLogs: [],
      pagination: { ...initialState.pagination },
      deletingEmailLogIds: [],
      deleteErrors: {},
    }),
  },

  extraReducers: (builder) => {
    builder
      .addCase(fetchAdminEmailLogs.pending, (state, action) => {
        state.loadingList = true;
        state.errorList = null;
        state.requestId = action.meta.requestId;
      })

      .addCase(fetchAdminEmailLogs.fulfilled, (state, action) => {
        // Ignore an older request that completed after a newer one.
        if (state.requestId !== action.meta.requestId) return;

        state.loadingList = false;
        state.requestId = null;

        const normalized = normalizeListResponse(
          action.payload,
          state.pagination
        );

        state.emailLogs = normalized.logs;
        state.pagination = normalized.pagination;
      })

      .addCase(fetchAdminEmailLogs.rejected, (state, action) => {
        if (state.requestId !== action.meta.requestId) return;

        state.loadingList = false;
        state.requestId = null;
        state.errorList =
          action.payload ||
          action.error?.message ||
          "Failed to fetch email logs";
      })

      .addCase(deleteAdminEmailLog.pending, (state, action) => {
        const id = action.meta.arg;

        if (!state.deletingEmailLogIds.includes(id)) {
          state.deletingEmailLogIds.push(id);
        }

        delete state.deleteErrors[id];
      })

      .addCase(deleteAdminEmailLog.fulfilled, (state, action) => {
        const { emailLogId } = action.payload;

        state.deletingEmailLogIds = state.deletingEmailLogIds.filter(
          (id) => id !== emailLogId
        );

        const existed = state.emailLogs.some(
          (log) => log.id === emailLogId
        );

        state.emailLogs = state.emailLogs.filter(
          (log) => log.id !== emailLogId
        );

        if (existed) {
          state.pagination.total = Math.max(
            0,
            state.pagination.total - 1
          );
        }

        state.pagination.totalPages = Math.ceil(
          state.pagination.total /
            Math.max(1, state.pagination.limit)
        );

        state.pagination.hasNextPage =
          state.pagination.page < state.pagination.totalPages;

        state.pagination.hasPreviousPage =
          state.pagination.page > 1;
      })

      .addCase(deleteAdminEmailLog.rejected, (state, action) => {
        const id = action.meta.arg;

        state.deletingEmailLogIds = state.deletingEmailLogIds.filter(
          (item) => item !== id
        );

        state.deleteErrors[id] =
          action.payload?.message ||
          action.error?.message ||
          "Failed to delete email log";
      });
  },
});

export const {
  clearAdminEmailLogsErrors,
  clearAdminEmailLogDeleteError,
  resetAdminEmailLogs,
} = adminEmailLogsSlice.actions;

export default adminEmailLogsSlice.reducer;
</file>

