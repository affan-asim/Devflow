const ALLOWED_SORT_ORDERS = new Set(["asc", "desc"]);

function parsePositiveInteger(value, fallback, maximum = Number.MAX_SAFE_INTEGER) {
  const parsed = Number(value);

  if (!Number.isSafeInteger(parsed) || parsed < 1) {
