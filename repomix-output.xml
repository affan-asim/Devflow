model RecruiterHistory {
  id                 String         @id @default(uuid())
  recruiterProfileId String
  companyId          String
  roleTitle          String
  employmentType     EmploymentType
  salary             Decimal?
  currency           Currency?
  description        String?
  startDate          DateTime?
  endDate            DateTime?
  isCurrent          Boolean        @default(false)
  isOwner            Boolean        @default(false)

  recruiter RecruiterProfile @relation(fields: [recruiterProfileId], references: [id])

  company Company @relation(fields: [companyId], references: [id])

  recruiterEvents RecruiterEvent[]
}

model EmployementEvent {
  id                    String      @id @default(uuid())
  employmentHistoryId   String
  type                  Type
  reason                String
  letterUrl             String?
  status                LeaveStatus @default(PENDING)
  approvedByRecruiterId String?
  createdAt             DateTime    @default(now())

  employmentHistory EmploymentHistory @relation(fields: [employmentHistoryId], references: [id])

  approvedBy RecruiterProfile? @relation("EmploymentApprovedBy", fields: [approvedByRecruiterId], references: [id])
}

model RecruiterEvent {
  id                    String      @id @default(uuid())
  recruiterHistoryId    String
  type                  Type
  reason                String
  letterUrl             String?
  status                LeaveStatus @default(PENDING)
  approvedByRecruiterId String?
  createdAt             DateTime    @default(now())

  recruiterHistory RecruiterHistory @relation(fields: [recruiterHistoryId], references: [id])

  approvedBy RecruiterProfile? @relation("RecruiterApprovedBy", fields: [approvedByRecruiterId], references: [id])
}

model Skill {
  id       String        @id @default(uuid())
  name     String        @unique
  isActive Boolean       @default(true)
  category SkillCategory

  developerProfiles DeveloperProfile[]
  jobs              Job[]

  @@index([category])
  @@index([name])
}

model Job {
  id                 String          @id @default(uuid())
  recruiterId        String
  companyId          String
  title              String
  description        String
  employmentType     EmploymentType  @default(FULLTIME)
  experienceLevel    ExperienceLevel
  locationPreference LOCATION
  status             JobStatus       @default(DRAFT)
  minSalary          Decimal
  maxSalary          Decimal
  currency           Currency        @default(USD)
  isFeatured         Boolean         @default(false)
  deadline           DateTime
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  publishedAt        DateTime        @default(now())

  recruiter    RecruiterProfile @relation(fields: [recruiterId], references: [id])
  company      Company          @relation(fields: [companyId], references: [id])
  skills       Skill[]
  savedBy      SavedJob[]
  applications Application[]

  @@index([status, createdAt(sort: Desc)])
  @@index([recruiterId])
  @@index([companyId])
  @@index([locationPreference])
  @@index([employmentType])
  @@index([experienceLevel])
  @@index([deadline])
  @@index([status, locationPreference, experienceLevel])
  @@index([status, employmentType, experienceLevel])
  @@index([companyId, status])
}

model Application {
  id              String   @id @default(uuid())
  jobId           String
  devProfileId    String
  rejectionReason String?
  coverLetterId   String?
  resumeId        String?
  status          STATUS   @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  job              Job              @relation(fields: [jobId], references: [id])
  developerProfile DeveloperProfile @relation(fields: [devProfileId], references: [id])

  resume      File? @relation("AppResume", fields: [resumeId], references: [id])
  coverLetter File? @relation("AppCoverLetter", fields: [coverLetterId], references: [id])

  @@unique([jobId, devProfileId])
  @@index([jobId])
  @@index([devProfileId])
  @@index([status])
  @@index([jobId, status])
  @@index([devProfileId, status])
  @@index([createdAt])
}

model Notification {
  id            String        @id @default(uuid())
  recipientId   String
  actionType    ActionType
  referenceType ReferenceType
  referenceId   String
  message       String
  isRead        Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  recipient User @relation(fields: [recipientId], references: [id])

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([recipientId, isRead])
  @@index([actionType])
  @@index([referenceId])
}

model VerificationOtp {
  id        String           @id @default(uuid())
  email     String
  otp       String
  type      VerificationType
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@index([email, type])
  @@index([expiresAt])
}

model EmailLog {
  id           String         @id @default(uuid())
  email        String
  status       EmailLogStatus
  type         EmailType
  errorMessage String?
  createdAt    DateTime       @default(now())
}

model SavedJob {
  id           String   @id @default(uuid())
  devProfileId String
  jobId        String
  createdAt    DateTime @default(now())

  developer DeveloperProfile @relation(fields: [devProfileId], references: [id], onDelete: Cascade)
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([devProfileId, jobId])
  @@index([devProfileId])
  @@index([jobId])
}
